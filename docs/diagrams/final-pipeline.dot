digraph pipeline {
  graph [rankdir=LR, bgcolor="white", pad="0.32", nodesep="0.28", ranksep="0.55", fontname="Arial", label="Final model: a stack of TabPFN v3.5 variants", labelloc="t", labeljust="l", fontsize=22, fontcolor="#16324a"];
  node [shape=box, style="rounded,filled", fillcolor="#f3f7fa", color="#bdcbd5", fontname="Arial", fontsize=14, fontcolor="#16324a", margin="0.20,0.12", penwidth=1.2];
  edge [color="#687c89", arrowsize=0.8, penwidth=1.3, fontname="Arial", fontsize=11, fontcolor="#465c6b"];
  feat [label="Baseline features (23)\ncabin deck/num/side, spend totals,\nage flags, group & surname sizes\nfold-local ordinal encoding"];
  m1 [label="Frozen TabPFN v3.5\nin-context only"];
  m2 [label="Fine-tuned\n30 epochs, lr 1e-5\nSGKF(8) early stopping"];
  m3 [label="Fine-tune → refit\nepoch count from slice,\nrefit on whole fold"];
  m4 [label="Fine-tuned, 100 epochs\npatience 20, inference\nwith 2 estimators", fillcolor="#fff5e7", color="#d2b587"];
  lr [label="Logistic regression\non member logits (C=1)\nnested: fitted on other folds", fillcolor="#e4f3ef", color="#82b5a7"];
  out [label="P(Transported) ≥ 0.5"];
  feat -> m1; feat -> m2; feat -> m3; feat -> m4 [style=dashed];
  m1 -> lr; m2 -> lr; m3 -> lr; m4 -> lr [style=dashed, label="best-LB variant"];
  lr -> out;
}
